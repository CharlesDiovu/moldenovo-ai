"""
report.py
Builds a PDF report of a campaign. Drawings come from RDKit.
The cover picture is the Muse Image hero artwork (decoration only).
"""

import io
import os
from xml.sax.saxutils import escape

from rdkit import Chem
from rdkit.Chem.Draw import rdMolDraw2D
from reportlab.lib import colors
from reportlab.lib.pagesizes import A4
from reportlab.lib.styles import ParagraphStyle, getSampleStyleSheet
from reportlab.lib.units import mm
from reportlab.platypus import (Image, KeepTogether, PageBreak, Paragraph,
                                SimpleDocTemplate, Spacer, Table, TableStyle)

HERE = os.path.dirname(os.path.abspath(__file__))
HERO = os.path.join(HERE, "..", "frontend", "public", "hero.png")
TEAL = colors.HexColor("#0f8b8d")
NAVY = colors.HexColor("#0b1f3a")

ss = getSampleStyleSheet()
H1 = ParagraphStyle("H1", parent=ss["Title"], textColor=NAVY, fontSize=26, leading=30)
H2 = ParagraphStyle("H2", parent=ss["Heading2"], textColor=NAVY, spaceBefore=10)
BODY = ParagraphStyle("B", parent=ss["BodyText"], fontSize=9.5, leading=13)
SMALL = ParagraphStyle("S", parent=BODY, fontSize=8, textColor=colors.HexColor("#555555"))
MONO = ParagraphStyle("M", parent=SMALL, fontName="Courier")


def p(text, style=BODY):
    return Paragraph(escape(str(text)), style)


def mol_image(smiles, w=62 * mm, h=45 * mm):
    mol = Chem.MolFromSmiles(smiles)
    if mol is None:
        return p("(could not draw)", SMALL)
    d = rdMolDraw2D.MolDraw2DCairo(480, 345)
    d.DrawMolecule(mol)
    d.FinishDrawing()
    return Image(io.BytesIO(d.GetDrawingText()), width=w, height=h)


def props_table(before, after):
    rows = [["", "Before", "After"]]
    for label, key in (("QED", "qed"), ("LogP", "logp"), ("TPSA", "tpsa"), ("MW", "mw")):
        rows.append([label, before.get(key, "-"), after.get(key, "-")])
    t = Table(rows, colWidths=[22 * mm, 25 * mm, 25 * mm])
    t.setStyle(TableStyle([
        ("FONTSIZE", (0, 0), (-1, -1), 8.5),
        ("BACKGROUND", (0, 0), (-1, 0), colors.HexColor("#e3f6f6")),
        ("GRID", (0, 0), (-1, -1), 0.3, colors.HexColor("#bbbbbb")),
    ]))
    return t


def build_report(project):
    buf = io.BytesIO()
    doc = SimpleDocTemplate(buf, pagesize=A4, leftMargin=18 * mm, rightMargin=18 * mm,
                            topMargin=16 * mm, bottomMargin=16 * mm,
                            title="MolDeNovo campaign report")
    s = project.get("settings", {})
    r = project.get("result", {})
    models = project.get("models", {})
    out = []

    # Cover
    out.append(Spacer(1, 10 * mm))
    out.append(Paragraph("MolDeNovo", H1))
    out.append(p("Campaign report", ParagraphStyle("sub", parent=BODY, fontSize=13)))
    out.append(Spacer(1, 6 * mm))
    if os.path.exists(HERO):
        out.append(Image(HERO, width=170 * mm, height=95 * mm, kind="proportional"))
        out.append(p("Cover art generated by Muse Image. Decoration only; it shows no chemistry.", SMALL))
    out.append(Spacer(1, 6 * mm))
    out.append(p(f"Saved: {project.get('saved_at', 'unknown')}"))
    out.append(p(f"Starting molecule: {s.get('smiles', '')}", MONO))
    out.append(PageBreak())

    # Settings
    out.append(Paragraph("Settings", H2))
    rows = [
        ["Goal", f"LogP <= {s.get('logp_max')}, TPSA <= {s.get('tpsa_max')}"],
        ["Protected groups", ", ".join(s.get("protected", [])) or "none"],
        ["Minimum similarity", s.get("min_similarity")],
        ["Stop when goals met", s.get("stop_when_met")],
    ]
    t = Table([[p(a, SMALL), p(b)] for a, b in rows], colWidths=[40 * mm, 120 * mm])
    t.setStyle(TableStyle([("GRID", (0, 0), (-1, -1), 0.3, colors.HexColor("#cccccc"))]))
    out.append(t)

    # Summary
    start, final = r.get("start", {}), r.get("final", {})
    out.append(Paragraph("Result", H2))
    out.append(p(f"{len(r.get('steps', []))} accepted step(s). Stopped because: {r.get('stop_reason', '')}"))
    if start.get("smiles") and final.get("smiles"):
        t = Table([[mol_image(start["smiles"]), mol_image(final["smiles"])],
                   [p("Start", SMALL), p("Final", SMALL)]], colWidths=[85 * mm, 85 * mm])
        out.append(t)
        out.append(props_table(start, final))

    # Steps
    out.append(Paragraph("Steps", H2))
    for st in r.get("steps", []):
        block = [
            Paragraph(escape(f"Step {st['step']}: {st['edit_name']}  (planner: {st.get('planner', '?')})"), H2),
            p(st.get("rationale", "")),
        ]
        ev = st.get("evidence")
        if ev:
            block.append(p(f"Evidence (computed by RDKit from {ev.get('series', '')}): {ev.get('summary', '')}", SMALL))
        block.append(Spacer(1, 2 * mm))
        block.append(Table([[mol_image(st["before"]["smiles"]), mol_image(st["after"]["smiles"])]],
                           colWidths=[85 * mm, 85 * mm]))
        block.append(props_table(st["before"], st["after"]))
        block.append(p(f"After: {st['after']['smiles']}   |   similarity to start {st.get('similarity_to_start')}", MONO))
        out.append(KeepTogether(block))

    # Rejections
    out.append(Paragraph(f"Rejected ideas ({len(r.get('rejections', []))})", H2))
    for rej in r.get("rejections", []):
        out.append(p(f"Step {rej['step']} - {rej['edit_id']}: {rej['reason']}", SMALL))

    # Provenance and limits
    out.append(Paragraph("Provenance", H2))
    for k, v in models.items():
        out.append(p(f"{k}: {v}", SMALL))
    out.append(Paragraph("Limits", H2))
    for line in (
        "Evidence measures EGFR potency (ChEMBL CHEMBL203), not solubility or metabolism.",
        "No docking, trained ADMET model or synthesis check was used.",
        "Structural alerts are warnings, not proof of toxicity.",
        "Every suggested edit is a hypothesis to test in the lab.",
    ):
        out.append(p("- " + line, SMALL))

    doc.build(out)
    return buf.getvalue()